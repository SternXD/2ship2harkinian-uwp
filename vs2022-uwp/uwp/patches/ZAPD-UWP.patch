From 6ffd8a5b912ca5a713182d8341d85887ea531cf8 Mon Sep 17 00:00:00 2001
From: SternXD <stern@sidestore.io>
Date: Fri, 12 Dec 2025 14:59:16 -0500
Subject: [PATCH] UWP: Add UWP compatibility and progress reporting

---
 ZAPD/Main.cpp | 44 ++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/ZAPDTR/ZAPD/Main.cpp b/ZAPD/Main.cpp
index 4598da9..0f18098 100644
--- a/ZAPDTR/ZAPD/Main.cpp
+++ b/ZAPDTR/ZAPD/Main.cpp
@@ -4,6 +4,50 @@
 #include <Utils/Directory.h>
 #include "WarningHandler.h"
 
+#ifdef _UWP
+#include <Windows.h>
+#include <cstdio>
+#include <cstdarg>
+
+extern "C" {
+    typedef void (*ZapdProgressCallback)(const char* message);
+    
+    static ZapdProgressCallback s_zapdProgressCallback = nullptr;
+    
+    #ifdef _UWP
+    __declspec(dllexport) void SetZapdProgressCallback(ZapdProgressCallback callback) {
+        s_zapdProgressCallback = callback;
+    }
+    #else
+    void SetZapdProgressCallback(ZapdProgressCallback callback) {
+        s_zapdProgressCallback = callback;
+    }
+    #endif
+    
+    ZapdProgressCallback g_zapdProgressCallback = nullptr;
+}
+
+int zapd_printf(const char* format, ...) {
+    char buffer[4096];
+    va_list args;
+    va_start(args, format);
+    int result = vsnprintf(buffer, sizeof(buffer), format, args);
+    va_end(args);
+
+    // Call the callback if set
+    if (s_zapdProgressCallback) {
+        s_zapdProgressCallback(buffer);
+    }
+
+    // Also output to debug console
+    OutputDebugStringA(buffer);
+    return result;
+}
+
+// Redirect printf to our wrapper for UWP
+#define printf zapd_printf
+#endif
+
 // Linker Hacks Begin
 #include "ZAnimation.h"
 ZNormalAnimation nAnim(nullptr);
-- 
2.51.1.windows.1

